{
  "id": "ember-light",
  "name": "Ember",
  "family": "ember",
  "about": "Charcoal and copper",
  "group": "Palettes",
  "dark": false,
  "preview": [
    "#FBF6F2",
    "#B5562A",
    "#F3EAE3"
  ],
  "vars": {
    "--theme-bg": "#FBF6F2",
    "--theme-side": "#F3EAE3",
    "--theme-panel": "#FFFFFF",
    "--theme-elev": "#FFFFFF",
    "--theme-user": "rgba(36,25,20,.07)",
    "--theme-code": "#F4ECE6",
    "--theme-border": "rgba(36,25,20,.10)",
    "--theme-text": "#241914",
    "--theme-muted": "rgba(36,25,20,.62)",
    "--theme-accent": "#B5562A",
    "--theme-accent-text": "#FFFFFF",
    "--theme-hover": "rgba(36,25,20,.05)",
